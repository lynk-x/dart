# ─────────────────────────────────────────────────────────
#  Lynk-X PWA — Environment Configuration
#  Use these keys with the --dart-define flag during build:
#  flutter build web --release --dart-define=NEXT_PUBLIC_SUPABASE_URL=... --dart-define=NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
# ─────────────────────────────────────────────────────────

# Required for Supabase integration
NEXT_PUBLIC_SUPABASE_URL=your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-pub-key

# Required for Firebase Web Push (public VAPID key, not a secret)
# Found in: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key-here

# Optional: Sentry error reporting
NEXT_PUBLIC_SENTRY_DSN=https://...

# Performance/Debug
ENABLE_CRASH_REPORTING=true
